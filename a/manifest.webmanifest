{
  "id": "/app",
  "name": "HybridX",
  "short_name": "HybridX",
  "description": "AI-powered training app for hybrid athletes. Combine strength and endurance in one plan.",
  "theme_color": "#141417",
  "background_color": "#141417",
  "display": "standalone",
  "display_override": ["standalone"],
  "orientation": "portrait",
  "scope": "/",
  "start_url": "/app?source=pwa",
  "lang": "en",
  "dir": "ltr",
  "categories": ["health", "fitness", "lifestyle", "sports"],
  "prefer_related_applications": false,
  "shortcuts": [
    {
      "name": "Today's Workout",
      "short_name": "Today",
      "description": "Jump straight to your scheduled session",
      "url": "/app/training/overview?source=pwa-shortcut",
      "icons": [{ "src": "assets/icons/icon-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "AI Coach",
      "short_name": "Coach",
      "description": "Open the AI Coach chat",
      "url": "/app/coach/chat?source=pwa-shortcut",
      "icons": [{ "src": "assets/icons/icon-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Statistics",
      "short_name": "Stats",
      "description": "View training statistics",
      "url": "/app/training/statistics?source=pwa-shortcut",
      "icons": [{ "src": "assets/icons/icon-192x192.png", "sizes": "192x192" }]
    }
  ],
  "icons": [
